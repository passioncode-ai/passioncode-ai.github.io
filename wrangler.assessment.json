{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "passioncode-assessment",
  "compatibility_date": "2026-09-03",
  "main": "worker/assessment.js",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist-assessment",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/story/film/*",
      "/story/comic/audio/*",
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "assessment.passioncode.ai",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "passioncode-site",
      "database_id": "61632ee2-ae1b-453a-a112-18d1025b9c22"
    }
  ]
}
