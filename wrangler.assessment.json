{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "passioncode-assessment",
  "compatibility_date": "2026-09-03",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist-assessment",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "assessment.passioncode.ai",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
