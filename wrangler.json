{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "passioncode-ai",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "passioncode.ai",
      "custom_domain": true
    },
    {
      "pattern": "www.passioncode.ai",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "passioncode-site",
      "database_id": "61632ee2-ae1b-453a-a112-18d1025b9c22",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "ratelimits": [
    {
      "name": "LEAD_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "vars": {
    "LEAD_FROM": "commercial@passioncode.ai",
    "LEAD_REPLY_TO": "commercial@passioncode.ai",
    "LEAD_NOTIFY_TO": "commercial@passioncode.ai",
    "PLATFORM_URL": "https://api.passioncode.ai"
  },
  "observability": {
    "enabled": true
  }
}
