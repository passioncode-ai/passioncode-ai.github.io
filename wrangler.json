{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "passioncode-ai",
  "account_id": "43da56547c0f538daaf7e94c6179faae",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "passioncode.ai",
      "custom_domain": true
    },
    {
      "pattern": "www.passioncode.ai",
      "custom_domain": true
    }
  ]
}
